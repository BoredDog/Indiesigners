; Echoes of Sorrow: Godot 4 port (side track; the Phaser build in ../src is the jam prototype).
; Story data is shared: ../content/*.json is copied into res://content by tools/sync-godot-content.sh.

config_version=5

[application]

config/name="Echoes of Sorrow (Godot)"
config/description="Supernatural investigation thriller told as an interactive comic."
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

StoryData="*res://core/story_data.gd"
GameState="*res://core/game_state.gd"
Deductions="*res://core/deduction_controller.gd"
Router="*res://core/router.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.043, 0.043, 0.055, 1)
