  "openingNarration": "The river should have carried me away from the tower.",
  "closingNarration": "The time on my watch was the time they erased.",
  "bubbles": [
    {
      "panel": "P1",
      "kind": "narration",
      "text": "I remember the water because it was the last ordinary thing.",
      "x": 161,
      "y": 62,
      "maxWidth": 275
    },
    {
      "panel": "P1",
      "kind": "speech",
      "text": "The river was moving.",
      "x": 422,
      "y": 70,
      "tail": {
        "x": -40,
        "y": 70
      },
      "maxWidth": 220
    },
    {
      "panel": "P2",
      "kind": "narration",
      "text": "The watch remembered a different night.",
      "x": 184,
      "y": 62,
      "maxWidth": 320
    },
    {
      "panel": "P2",
      "kind": "speech",
      "text": "My watch kept going.",
      "x": 780,
      "y": 70,
      "tail": {
        "x": -40,
        "y": 70
      },
      "maxWidth": 220
    },
    {
      "panel": "P3",
      "kind": "narration",
      "text": "The river did not vanish. It was diverted.",
      "x": 161,
      "y": 62,
      "maxWidth": 275
    },
    {
      "panel": "P3",
      "kind": "speech",
      "text": "This was not a drought.",
      "x": 422,
      "y": 70,
      "tail": {
        "x": -40,
        "y": 70
      },
      "maxWidth": 220
    },
    {
      "panel": "P4",
      "kind": "narration",
      "text": "The figure moved after 2:17.",
      "x": 184,
      "y": 62,
      "maxWidth": 320
    },
    {
      "panel": "P4",
      "kind": "speech",
      "text": "I saw someone carrying her.",
      "x": 780,
      "y": 70,
      "tail": {
        "x": -40,
        "y": 70
      },
      "maxWidth": 220
    },
    {
      "panel": "P5",
      "kind": "narration",
      "text": "I had seen that case before.",
      "x": 184,
      "y": 62,
      "maxWidth": 320
    },
    {
      "panel": "P5",
      "kind": "speech",
      "text": "I knew the coat.",
      "x": 601,
      "y": 70,
      "tail": {
        "x": -40,
        "y": 70
      },
      "maxWidth": 220
    },
    {
      "panel": "P6",
      "kind": "narration",
      "text": "The same water carried the same memory twice.",
      "x": 184,
      "y": 62,
      "maxWidth": 320
    }
  ],
