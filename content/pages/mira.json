    },
    {
      "panel": "P3",
      "kind": "narration",
      "text": "No hand had pulled the rope. Something else had.",
      "x": 560,
      "y": 300,
      "maxWidth": 300
    },
    {
      "panel": "P4",
      "kind": "speech",
      "text": "This was written after the bell.",
