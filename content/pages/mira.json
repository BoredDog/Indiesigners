  "openingNarration": "The bell stopped the same way every clock did.",
  "closingNarration": "The evidence was clearer than the memory.",
  "bubbles": [
    {
      "panel": "P1",
      "kind": "narration",
      "text": "The village still looked ordinary before the minute that broke it.",
