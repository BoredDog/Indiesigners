  "openingNarration": "The lantern had rules. I remembered teaching them to him.",
  "closingNarration": "The machine did not malfunction. Someone told it to do this.",
  "bubbles": [
    {
      "panel": "P1",
      "kind": "narration",
      "text": "The lantern was never a simple lamp.",
      "x": 184,
      "y": 62,
      "maxWidth": 320
    },
    {
      "panel": "P1",
      "kind": "speech",
      "text": "It records. It extracts. It can transfer.",
      "x": 780,
      "y": 70,
      "tail": {
        "x": -40,
        "y": 70
      },
      "maxWidth": 220
    },
    {
      "panel": "P2",
      "kind": "narration",
      "text": "The warning was written in her own hand.",
      "x": 161,
      "y": 62,
      "maxWidth": 275
    },
    {
      "panel": "P2",
      "kind": "speech",
      "text": "Never connect all nodes at once.",
      "x": 422,
      "y": 70,
      "tail": {
        "x": -40,
        "y": 70
      },
      "maxWidth": 220
    },
    {
      "panel": "P3",
      "kind": "narration",
      "text": "Someone had already asked the lantern a question it could not answer.",
      "x": 161,
      "y": 62,
      "maxWidth": 275
    },
    {
      "panel": "P3",
      "kind": "speech",
      "text": "She was the test.",
      "x": 422,
      "y": 70,
      "tail": {
        "x": -40,
        "y": 70
      },
      "maxWidth": 220
    },
    {
      "panel": "P4",
      "kind": "narration",
      "text": "I had forgotten the exact shape of the moment.",
      "x": 184,
      "y": 62,
      "maxWidth": 320
    },
    {
      "panel": "P4",
      "kind": "speech",
      "text": "~Elias, stop.~",
      "x": 780,
      "y": 70,
      "tail": {
        "x": -40,
        "y": 70
      },
      "maxWidth": 220
    },
    {
      "panel": "P4",
      "kind": "speech",
      "text": "~Just once.~",
      "x": 600,
      "y": 175,
      "tail": {
        "x": -40,
        "y": 70
      },
      "maxWidth": 220
    },
    {
      "panel": "P5",
      "kind": "narration",
      "text": "The lantern did what it had been told to do.",
      "x": 184,
      "y": 62,
      "maxWidth": 320
    },
    {
      "panel": "P5",
      "kind": "shout",
      "text": "Shut it down!",
      "x": 601,
      "y": 70,
      "tail": {
        "x": -40,
        "y": 70
      },
      "maxWidth": 220
    },
    {
      "panel": "P6",
      "kind": "narration",
      "text": "After the experiment, someone removed his own name from the evidence.",
      "x": 184,
      "y": 62,
      "maxWidth": 320
    }
  ],
